#!/usr/bin/env bashio
# ==============================================================================
# Arrête l'app si cloudflared plante (jeton invalide, etc.)
# ==============================================================================

declare exit_code=${1}

if [[ "${exit_code}" -ne 0 ]] && [[ "${exit_code}" -ne 256 ]]; then
    bashio::log.warning "Cloudflare Tunnel s'est arrêté (code ${exit_code}), arrêt de l'app."
    echo "${exit_code}" > /run/s6-linux-init-container-results/exitcode
    exec /run/s6/basedir/bin/halt
fi
