#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Démarre Cloudflare Tunnel si un jeton est configuré
# ==============================================================================

if ! bashio::config.has_value 'cloudflare_tunnel_token'; then
    bashio::log.info "Aucun jeton Cloudflare Tunnel : le site n'est pas publié sur Internet."
    exec sleep infinity
fi

bashio::log.info "Démarrage de Cloudflare Tunnel..."
# Passé par variable d'environnement pour ne pas apparaître dans la liste des processus
TUNNEL_TOKEN="$(bashio::config 'cloudflare_tunnel_token')"
export TUNNEL_TOKEN
exec s6-setuidgid nobody cloudflared tunnel --no-autoupdate run
