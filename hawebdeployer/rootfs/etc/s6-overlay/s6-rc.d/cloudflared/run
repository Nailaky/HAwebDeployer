#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Démarre Cloudflare Tunnel si un jeton est configuré
# ==============================================================================

if ! bashio::config.has_value 'cloudflare_tunnel_token'; then
    bashio::log.info "Aucun jeton Cloudflare Tunnel : les sites ne sont pas publiés sur Internet."
    exec sleep infinity
fi

bashio::log.info "Démarrage de Cloudflare Tunnel..."
# Passé par variable d'environnement pour ne pas apparaître dans la liste des processus
TUNNEL_TOKEN="$(bashio::config 'cloudflare_tunnel_token')"
export TUNNEL_TOKEN
# Métriques locales : le panneau y lit l'état du tunnel et les noms de domaine
exec s6-setuidgid nobody cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:20241 run
