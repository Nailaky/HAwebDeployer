#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Exécute les workers (_worker.js) des sites
# ==============================================================================

# Les workers sont du code utilisateur : ils ne doivent lire ni le jeton du
# Supervisor ni celui du tunnel. Ils tournent sous leur propre utilisateur,
# sans ces variables.
chmod 700 /run/s6/container_environment
chmod 600 /data/options.json 2>/dev/null || true

# Variables des options (env.NOM dans les workers), dans un fichier lisible par
# les workers seuls plutôt qu'en arguments de commande, visibles par tous
install -d -m 700 -o worker /run/worker
(
    umask 077
    bashio::app.config | jq -c '[.worker_variables[]? | {(.name): .value}] | add // {}' > /run/worker/vars.json
)
chown worker /run/worker/vars.json

# Tourne même sans _worker.js : chaque worker se charge dès que son fichier apparaît
exec s6-setuidgid worker env -i PATH=/usr/bin:/bin HA_URL=http://127.0.0.1:8124 \
    SITE_BASE="/share/$(bashio::config 'site_folder')" \
    node /opt/hawebdeployer/runtime.mjs
