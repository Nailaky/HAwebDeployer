#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Démarre l'API du panneau d'administration (envoi des fichiers du site)
# ==============================================================================

site_folder="$(bashio::config 'site_folder')"

tunnel_enabled=0
if bashio::config.has_value 'cloudflare_tunnel_token'; then
    tunnel_enabled=1
fi

# Socket réservé à Caddy : le worker et cloudflared ne peuvent pas l'ouvrir
install -d -m 750 -g caddy /run/hawebdeployer

# Tourne en root pour écrire dans le dossier du site, sans les jetons de l'app
exec env -i PATH=/usr/bin:/bin \
    SITE_ROOT="/share/${site_folder}" SITE_FOLDER="${site_folder}" \
    TUNNEL_ENABLED="${tunnel_enabled}" CADDY_GID="$(id -g caddy)" \
    node /opt/hawebdeployer/admin.mjs
