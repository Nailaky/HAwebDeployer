{
	admin off
	auto_https off
	persist_config off

	servers {
		# HTTPS est assuré par Cloudflare, le tunnel parle en HTTP/1.1 en local
		protocols h1
		# Proxys de confiance : cloudflared (même conteneur) et l'Ingress du Supervisor
		trusted_proxies static 127.0.0.1/32 ::1/128 172.30.32.2/32
		client_ip_headers Cf-Connecting-IP
	}

	log {
		format console
	}
}

# Un site : fichiers statiques, puis son worker. Arguments : dossier, port.
# Utilisé dans un bloc route : les directives s'exécutent dans cet ordre
(site) {
	root * {args[0]}

	# Fichiers cachés (.git, .env, ...) et code du worker : jamais servis
	@hidden{args[1]} {
		path */.* /_worker.js
		not path /.well-known/*
	}
	respond @hidden{args[1]} 404

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	encode zstd gzip

	# Rien de publié pour l'instant : page d'attente
	@empty{args[1]} {
		path /
		not file /index.html /_worker.js
	}
	handle @empty{args[1]} {
		root * /var/www/placeholder
		file_server
	}

	file_server {
		pass_thru
	}
	# Le worker sait de quel site vient la requête (en-tête imposé par Caddy)
	request_header X-Site {args[1]}
	request_header X-Real-IP {client_ip}
	reverse_proxy 127.0.0.1:8787
}

(errors) {
	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}

# Site public sur un port : Cloudflare Tunnel et réseau local. Arguments : port, dossier
(public) {
	:{args[0]} {
		route {
			import site {args[1]} {args[0]}
		}
		header {
			X-Frame-Options DENY
			Strict-Transport-Security "max-age=31536000"
		}
		{$CSP_HEADER}
		import errors
	}
}

# Aperçu d'un site dans le panneau. Arguments : port, dossier
(preview) {
	handle_path /apercu/{args[0]}/* {
		{$CSP_HEADER_INGRESS}
		route {
			import site {args[1]} {args[0]}
		}
	}
}

# Un site par port, de 8080 à 8089 (fichier généré au démarrage)
import /run/caddy/sites.caddy

# Panneau de l'app dans Home Assistant (Ingress), affiché dans un cadre de HA
:8099 {
	route {
		# Seul le proxy Ingress du Supervisor a le droit de se connecter
		@outside not remote_ip 172.30.32.2
		respond @outside 403 {
			close
		}

		import /run/caddy/previews.caddy

		# API d'envoi des fichiers : socket accessible à Caddy seulement
		handle /api/* {
			header Cache-Control no-store
			reverse_proxy unix//run/hawebdeployer/admin.sock
		}

		handle {
			header {
				Content-Security-Policy "default-src 'self'; img-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'none'"
				Cache-Control no-cache
				X-Content-Type-Options nosniff
				-Server
			}
			root * /opt/hawebdeployer/admin
			file_server
		}
	}
	header X-Frame-Options SAMEORIGIN
	import errors
}

# Accès à Home Assistant pour les workers : seuls les services autorisés dans
# les options passent, et le jeton du Supervisor est ajouté ici, jamais par eux
:8124 {
	bind 127.0.0.1

	@allowed {
		method POST
		path {$HA_SERVICE_PATHS}
	}
	handle @allowed {
		request_body {
			max_size 64KB
		}
		rewrite * /core{uri}
		reverse_proxy http://supervisor {
			header_up Host supervisor
			header_up Authorization "Bearer {env.SUPERVISOR_TOKEN}"
		}
	}
	respond 403
}
