{
	admin off
	auto_https off
	persist_config off

	servers {
		# HTTPS est assuré par Cloudflare, le tunnel parle en HTTP/1.1 en local
		protocols h1
		# cloudflared tourne dans le même conteneur : on ne croit que ses en-têtes
		trusted_proxies static 127.0.0.1/32 ::1/128
		client_ip_headers Cf-Connecting-IP
	}

	log {
		format console
	}
}

(site) {
	root * {$SITE_ROOT}

	# Fichiers cachés (.git, .env, ...) : jamais servis
	@hidden {
		path */.*
		not path /.well-known/*
	}
	respond @hidden 404

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	encode zstd gzip
	file_server

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}

# Site public : Cloudflare Tunnel, et le port local s'il est activé
:8080 {
	import site
	header {
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
	}
	{$CSP_HEADER}
}

# Aperçu dans Home Assistant (Ingress) : affiché dans un cadre de l'interface HA
:8099 {
	# Seul le proxy Ingress du Supervisor a le droit de se connecter
	@outside not remote_ip 172.30.32.2
	respond @outside 403 {
		close
	}

	import site
	header X-Frame-Options SAMEORIGIN
	{$CSP_HEADER_INGRESS}
}
